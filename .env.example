# Copie para .env ao rodar na sua máquina. Em produção, defina estes valores no painel da hospedagem.
# O arquivo .env nunca deve ir para o Git.

# Caminho relativo à pasta prisma/. Fora da pasta public, para nunca ser servido pelo site.
DATABASE_URL="file:./dev.db"

# Obrigatório: valor aleatório com pelo menos 32 caracteres. O servidor não sobe sem ele.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Opcional: cria a conta SUPER_ADMIN ao iniciar. A senha precisa de pelo menos 12 caracteres.
# Vale só na criação: depois, troque a senha em Perfil > Editar perfil.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Opcional: outras origens que podem chamar a API, separadas por vírgula.
CORS_ORIGINS=""

# Opcional: quantos proxies da hospedagem ficam à frente do app. O padrão é 1.
TRUST_PROXY_HOPS=""

# Opcional: token gratuito da PandaScore, que liga a atualização de League of Legends.
# Sem ele, só os jogos de VALORANT se atualizam. Crie em https://app.pandascore.co/dashboard
PANDASCORE_TOKEN=""

# Opcional: de quantos em quantos minutos buscar os resultados, de 1 a 15. O padrão é 5, e 0 desliga.
RESULTS_SYNC_MINUTES=""
